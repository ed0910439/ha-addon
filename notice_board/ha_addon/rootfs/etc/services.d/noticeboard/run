#!/usr/bin/with-contenv bashio
set -euo pipefail

# shellcheck disable=SC1091
source /data/.noticeboard-runtime-env

cd /opt/noticeboard
bashio::log.info "Starting Notice Board on port 8000"
exec /opt/venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --proxy-headers \
    --forwarded-allow-ips "*"
